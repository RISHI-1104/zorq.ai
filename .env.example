# ZORQ AI - Environment Variables Template
# 
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# NEVER share your API keys publicly!

# ==========================================
# GROQ API Configuration
# ==========================================

# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here_replace_this

# AI Model to use
# Options: llama-3.1-8b-instant, mixtral-8x7b, gpt-4-turbo-preview, etc.
# See: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.1-8b-instant

# Maximum tokens in response (1024 is default, max typically 2048)
GROQ_MAX_TOKENS=1024

# ==========================================
# Flask Configuration
# ==========================================

# Server port (default: 5000)
PORT=5000

# Debug mode (true for development, false for production)
FLASK_DEBUG=false

# Flask environment (development or production)
FLASK_ENV=production

# ==========================================
# Application Configuration
# ==========================================

# Application name
APP_NAME=ZORQ AI

# Application version
APP_VERSION=1.0.0

# Allow debug logging
DEBUG_LOGGING=false

# ==========================================
# Security (Optional - for production)
# ==========================================

# Secret key for sessions (generate with: python -c "import secrets; print(secrets.token_hex(16))")
# SECRET_KEY=your_secret_key_here

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5000,https://yoursite.com

# Rate limiting (requests per minute)
# RATE_LIMIT=60

# ==========================================
# Notes
# ==========================================

# HOW TO USE:
# 1. Copy this file and rename to '.env'
# 2. Fill in the GROQ_API_KEY with your actual key from console.groq.com
# 3. Keep .env in your .gitignore (should already be there)
# 4. Never commit .env to version control
# 5. For deployment, set environment variables on your hosting platform

# SECURITY CHECKLIST:
# ✓ API key is secret - never share it
# ✓ Use .env for local development only
# ✓ Set environment variables on production servers
# ✓ Rotate API keys periodically
# ✓ Monitor API usage for suspicious activity
# ✓ Disable debug mode in production

# GETTING YOUR API KEY:
# 1. Go to https://console.groq.com
# 2. Sign up (free account)
# 3. Navigate to API Keys section
# 4. Create a new API key
# 5. Copy and paste into GROQ_API_KEY above
# 6. Save this file as .env
